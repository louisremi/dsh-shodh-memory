{
  "name": "dsh-shodh-memory",
  "version": "0.1.0",
  "description": "Native shodh-memory integration for DeepSeek Harness — persistent cognitive memory without an MCP server in the context window.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "shodh-memory",
    "memory",
    "persistent-memory",
    "no-mcp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
